# Child Diary Configuration
# Copy this file to .env and fill in your values

# Secret key for Flask sessions (generate with: python -c "import os; print(os.urandom(32).hex())")
SECRET_KEY=your-secret-key-here

# Admin password hash (generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))")
# Default password is 'your-password'
ADMIN_PASSWORD_HASH=your-password-hash-here

# Optional: Database path (default: diary.db)
# DATABASE_PATH=diary.db

# Optional: Upload folder (default: uploads)
# UPLOAD_FOLDER=uploads
